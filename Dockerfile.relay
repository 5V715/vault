# syntax=docker/dockerfile:1@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
# SPDX-License-Identifier: MIT
#
# vault-relay (the vault mailbox relay), multi-arch:
#   linux/amd64, linux/arm64, linux/arm/v7
# This is a reduced matrix by design; an embedding app's own image may build more.
#
#   docker buildx build -f Dockerfile.relay --platform linux/arm64,linux/arm/v7 -t IMAGE .
#
# Run it with the page origin of every app that uses the relay (comma-separated),
# behind a TLS-terminating reverse proxy (one hop; publish the port only to it,
# since --trust-proxy counts the rightmost X-Forwarded-For entry from
# loopback/private peers):
#
#   docker run -p 127.0.0.1:8080:8080 -e VAULT_RELAY_ALLOW_ORIGIN=https://app.example IMAGE --trust-proxy
#
# (or pass `--allow-origin https://app.example` as arguments). Without an allowed
# origin the container exits at once with status 2 and says why: an open relay
# would let any website use it. See docs/integration.md, "Running the relay".
#
# Every RUN stage executes on the build host ($BUILDPLATFORM); the binary is
# cross-compiled to a static musl binary with cargo-zigbuild (zig as the cross
# linker; no per-target C toolchains, no QEMU). The final stage is `scratch`,
# which contains no shell, so it needs no emulation either.

# The base image and the Dockerfile frontend are pinned by digest (see
# Dockerfile.todo-demo); CI posts a notice when upstream moved.
ARG RUST_IMAGE=rust:1-bookworm@sha256:75d26c23c24cc6ea1cdabf0714a6bff8fd7bf3248716043fd7ae86dac7f41b94

# ---- toolchain: rust + zig + cargo-zigbuild, sources limited to vault-mailbox
# and vault-proto (vault-relay validates allowed origins with its binding rules)
FROM --platform=$BUILDPLATFORM ${RUST_IMAGE} AS toolchain
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# Distro packages track bookworm security updates (not pinned). cargo-zigbuild and zig
# are pinned by version and sha256 in tools/release-requirements.txt (shared with the
# release workflow; linux x86_64 wheels, so the build host must be linux/amd64).
COPY tools/release-requirements.txt /tmp/release-requirements.txt
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-venv file \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/zig \
 && /opt/zig/bin/pip install --no-cache-dir --require-hashes --only-binary :all: -r /tmp/release-requirements.txt
ENV PATH="/opt/zig/bin:${PATH}" \
    CARGO_TERM_COLOR=never \
    CARGO_PROFILE_RELEASE_STRIP=true \
    CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY vault-mailbox vault-mailbox
COPY vault-proto vault-proto
# The other workspace members are not needed here, so drop them from the members;
# cargo then only prunes unused lock entries (versions of everything else stay as locked).
RUN sed -i 's#^members = .*#members = ["vault-mailbox", "vault-proto"]#' Cargo.toml \
 && grep -q '^members = \["vault-mailbox", "vault-proto"\]$' Cargo.toml \
 && cargo fetch
# Dependencies are fetched once here, into this shared layer. The per-platform
# builds below run --offline in parallel. They share no registry cache mount
# (parallel unpacking into one mount failed with ".cargo-ok File exists").

# ---- vault-relay, cross-compiled for $TARGETPLATFORM
FROM toolchain AS relay
ARG TARGETPLATFORM
RUN --mount=type=cache,target=/src/target,id=vault-relay-target-${TARGETPLATFORM},sharing=locked \
    set -eu; \
    case "${TARGETPLATFORM}" in \
      linux/amd64)  target=x86_64-unknown-linux-musl ;; \
      linux/arm64)  target=aarch64-unknown-linux-musl ;; \
      linux/arm/v7) target=armv7-unknown-linux-musleabihf ;; \
      *) echo "unsupported TARGETPLATFORM ${TARGETPLATFORM} (see the header of this Dockerfile)" >&2; exit 1 ;; \
    esac; \
    rustup target add "$target"; \
    cargo zigbuild --offline --release -p vault-mailbox --bin vault-relay --target "$target"; \
    install -m 0755 "target/$target/release/vault-relay" /vault-relay; \
    file /vault-relay > /tmp/file.txt; cat /tmp/file.txt; grep -Eq 'statically linked|static-pie linked' /tmp/file.txt

# ---- final image: the static binary, nothing else
FROM scratch
ARG VERSION=dev
LABEL org.opencontainers.image.title="vault-relay" \
      org.opencontainers.image.description="Relay mailbox for the vault protocol" \
      org.opencontainers.image.source="https://github.com/5V715/vault" \
      org.opencontainers.image.url="https://github.com/5V715/vault" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=relay /vault-relay /vault-relay
USER 65532:65532
EXPOSE 8080
# The allowlist comes from VAULT_RELAY_ALLOW_ORIGIN or --allow-origin; there is
# deliberately no default, so an unconfigured container fails fast.
ENTRYPOINT ["/vault-relay"]
