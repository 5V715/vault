#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Test-only stand-in for the SDK's apksigner (scripts/test/sign_android_apk_test.sh).

sign --ks KS [--ks-key-alias A] --v1-signing-enabled false --v2-signing-enabled true
     --v3-signing-enabled true --v4-signing-enabled false --out OUT IN
    writes IN plus a trailer naming the "certificate": the SHA-256 of KS's bytes.
    Any other scheme flags are refused, so the script's flags are checked too.
verify --verbose --print-certs APK
    prints apksigner's report lines for an APK it signed (fails on anything else).

Environment: VAULT_FAKE_APKSIGNER_SCHEMES (default "v3", what the real apksigner
writes for minSdk >= 28 with v2 and v3 enabled): the schemes verify reports as true; VAULT_FAKE_APKSIGNER_LOG: every invocation is appended (tab-joined).
"""
import hashlib
import os
import sys

MARK = b"\nFAKE-APK-SIGNATURE "


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def main():
    argv = sys.argv[1:]
    log = os.environ.get("VAULT_FAKE_APKSIGNER_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as f:
            f.write("\t".join(argv) + "\n")
    if argv[:1] == ["sign"]:
        args = argv[1:]
        opts = {}
        while len(args) > 1 and args[0].startswith("--"):
            opts[args[0]] = args[1]
            args = args[2:]
        if len(args) != 1:
            die(f"fake apksigner: unsupported sign arguments: {argv}")
        want = {"--v1-signing-enabled": "false", "--v2-signing-enabled": "true",
                "--v3-signing-enabled": "true", "--v4-signing-enabled": "false"}
        for k, v in want.items():
            if opts.get(k) != v:
                die(f"fake apksigner: expected {k} {v}, got {opts.get(k)}")
        extra = set(opts) - set(want) - {"--ks", "--ks-key-alias", "--out"}
        if extra or "--ks" not in opts or "--out" not in opts:
            die(f"fake apksigner: unsupported sign arguments: {argv}")
        with open(opts["--ks"], "rb") as f:
            cert = hashlib.sha256(f.read()).hexdigest()
        with open(args[0], "rb") as f:
            data = f.read()
        if MARK in data:
            die("fake apksigner: input is already signed")
        with open(opts["--out"], "wb") as f:
            f.write(data + MARK + cert.encode())
        return
    if argv[:3] == ["verify", "--verbose", "--print-certs"] and len(argv) == 4:
        with open(argv[3], "rb") as f:
            data = f.read()
        if MARK not in data:
            die("DOES NOT VERIFY\nERROR: Missing META-INF/MANIFEST.MF")
        cert = data.rsplit(MARK, 1)[1].decode()
        schemes = os.environ.get("VAULT_FAKE_APKSIGNER_SCHEMES", "v3").split()
        print("Verifies")
        print("Verified using v1 scheme (JAR signing): false")
        print(f"Verified using v2 scheme (APK Signature Scheme v2): {str('v2' in schemes).lower()}")
        print(f"Verified using v3 scheme (APK Signature Scheme v3): {str('v3' in schemes).lower()}")
        print("Verified using v4 scheme (APK Signature Scheme v4): false")
        print("Number of signers: 1")
        print("Signer #1 certificate DN: CN=test")
        print(f"Signer #1 certificate SHA-256 digest: {cert}")
        return
    die(f"fake apksigner: unsupported command: {argv}")


if __name__ == "__main__":
    main()
