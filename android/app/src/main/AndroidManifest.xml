<?xml version="1.0" encoding="utf-8"?>
<!-- Hardening: no backup of any kind (allowBackup=false for Android 11, and data
     extraction rules that exclude every domain from cloud backup and device
     transfer on 12+), vault files live in noBackupFilesDir, and the network
     security config allows TLS only, to system CAs (debug adds user CAs through
     src/debug/res/xml/network_security_config.xml). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vault"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- androidx.profileinstaller (pulled in transitively by Compose) adds an
             exported receiver that lets other apps trigger profile installs. A
             sideloaded vault has no use for it, and check-apks.sh asserts that
             MainActivity is the only exported component. Lint's MissingClass check
             doesn't see the class on its debug classpath, although the release
             merged manifest contains it (CI run 44906389916), hence the ignore. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
