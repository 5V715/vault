<?xml version="1.0" encoding="utf-8"?>
<!-- Hardening: no backup of any kind (allowBackup=false for Android 11, and data
     extraction rules that exclude every domain from cloud backup and device
     transfer on 12+), vault files live in noBackupFilesDir, and the network
     security config allows TLS only, to system CAs (debug adds user CAs through
     src/debug/res/xml/network_security_config.xml). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The relay (pairing, sessions) and the replicas: all TLS, from Rust. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Wi-Fi only" replication: is the network unmetered? -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Persisted replication jobs survive a reboot (JobInfo.setPersisted needs it;
         the app registers no boot receiver of its own). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The screen-lock prompt that unwraps each vault's key (BiometricPrompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Scanning the pairing code (CameraX + ZXing on the device; no Play Services). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- The session service and its notification (app id, origin, Stop). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VaultApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vault"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- configChanges: a running create or restore lives in this activity's
             composition; rotating must not cancel it (and wipe what it wrote). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|locale|layoutDirection|fontScale|fontWeightAdjustment"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the paired browser sessions (spec "Session lifecycle"). Not
             exported: only the app's own Stop action (a PendingIntent) reaches it. -->
        <service
            android:name=".pairing.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Encrypted storage session for a paired browser: while the user works in a web app paired with this phone, the vault serves that browser over a relay. The notification shows the app and origin and a Stop action that locks the vault." />
        </service>

        <!-- androidx.profileinstaller (pulled in transitively by Compose) adds an
             exported receiver that lets other apps trigger profile installs. A
             sideloaded vault has no use for it, and check-apks.sh asserts that
             MainActivity is the only exported component. Lint's MissingClass check
             doesn't see the class on its debug classpath, although the release
             merged manifest contains it (CI run 44906389916), hence the ignore. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- profileinstaller's startup initializer writes files/profileInstalled
             a few seconds after launch: app data outside the vault directories
             (VaultStorageTest.files_in_no_backup_dir caught it, CI run
             45692890745). The app ships no baseline profile it needs. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                tools:node="remove" />
        </provider>

        <!-- Background replication (JobScheduler; the system keeps the jobs, the
             app keeps no job database). Only the system binds it (BIND_JOB_SERVICE,
             as the system uid: no export needed; check-apks asserts that only
             MainActivity is exported). -->
        <service
            android:name=".replication.ReplicationJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
