<?xml version="1.0" encoding="utf-8"?>
<!-- Release: TLS only, system CAs only. (Rust networking does not use this: it
     has bundled webpki roots; see FactoryConfig.extraCaPem, debug only.) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
