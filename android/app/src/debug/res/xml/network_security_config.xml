<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (this file overrides src/main's in the debug variant):
     user-installed CAs are trusted too, for the LAN showcase's local CA, and
     cleartext is allowed to loopback only. Release builds never contain this. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
